# Copy to .env for local overrides. .env is git-ignored.
# Nothing here is required at Stage 0; the defaults in config/default.yaml apply.

# Override repository root discovery (rarely needed).
# PUBG_BOT_ROOT=C:\pubg

# Loopback bridge endpoint. Host must remain a loopback address.
# PUBG_BOT_BRIDGE_HOST=127.0.0.1
# PUBG_BOT_BRIDGE_PORT=17311

# Shared secret between the Overwolf bridge and the Python controller.
# Leave unset to generate a fresh random token at startup (recommended).
# PUBG_BOT_SESSION_TOKEN=

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
# PUBG_BOT_LOG_LEVEL=INFO
