{
  "$defs": {
    "ControlState": {
      "enum": [
        "idle",
        "precheck",
        "acquire_sensors",
        "acquire_heading",
        "align_to_edge",
        "advance_edge",
        "verify_node",
        "execute_door",
        "execute_stairs",
        "execute_loot",
        "recover",
        "complete",
        "abort"
      ],
      "title": "ControlState",
      "type": "string"
    },
    "RunOutcome": {
      "enum": [
        "completed",
        "aborted",
        "failed",
        "emergency_stopped",
        "dry_run"
      ],
      "title": "RunOutcome",
      "type": "string"
    },
    "SensorSummary": {
      "additionalProperties": false,
      "description": "Aggregate sensor health for the run - the first thing to check when a\nrun fails for no obvious reason.",
      "properties": {
        "frame_age_p95_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame Age P95 S"
        },
        "frames_captured": {
          "default": 0,
          "title": "Frames Captured",
          "type": "integer"
        },
        "heading_abstentions": {
          "default": 0,
          "title": "Heading Abstentions",
          "type": "integer"
        },
        "heading_confidence_p50": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Heading Confidence P50"
        },
        "heading_samples": {
          "default": 0,
          "title": "Heading Samples",
          "type": "integer"
        },
        "invalid_reason_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Invalid Reason Counts",
          "type": "object"
        },
        "location_interval_p50_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location Interval P50 S"
        },
        "location_interval_p95_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location Interval P95 S"
        },
        "location_updates": {
          "default": 0,
          "title": "Location Updates",
          "type": "integer"
        },
        "max_location_gap_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Location Gap S"
        },
        "samples": {
          "default": 0,
          "title": "Samples",
          "type": "integer"
        },
        "stale_intervals": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Stale Intervals",
          "type": "array"
        }
      },
      "title": "SensorSummary",
      "type": "object"
    }
  },
  "$id": "https://pubg-training-bot.local/schemas/run-summary.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "abort_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Abort Reason"
    },
    "commands_executed": {
      "default": 0,
      "title": "Commands Executed",
      "type": "integer"
    },
    "commands_issued": {
      "default": 0,
      "title": "Commands Issued",
      "type": "integer"
    },
    "commands_rejected": {
      "default": 0,
      "title": "Commands Rejected",
      "type": "integer"
    },
    "duration_s": {
      "minimum": 0,
      "title": "Duration S",
      "type": "number"
    },
    "ended_at": {
      "title": "Ended At",
      "type": "string"
    },
    "evidence_files": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Files",
      "type": "array"
    },
    "last_node_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Node Id"
    },
    "last_state": {
      "$ref": "#/$defs/ControlState",
      "default": "idle"
    },
    "live_verified": {
      "default": false,
      "title": "Live Verified",
      "type": "boolean"
    },
    "loot_picked": {
      "items": {
        "type": "string"
      },
      "title": "Loot Picked",
      "type": "array"
    },
    "nodes_reached": {
      "default": 0,
      "title": "Nodes Reached",
      "type": "integer"
    },
    "nodes_total": {
      "default": 0,
      "title": "Nodes Total",
      "type": "integer"
    },
    "outcome": {
      "$ref": "#/$defs/RunOutcome"
    },
    "recovery_attempts": {
      "default": 0,
      "title": "Recovery Attempts",
      "type": "integer"
    },
    "recovery_by_level": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Recovery By Level",
      "type": "object"
    },
    "rejection_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Rejection Counts",
      "type": "object"
    },
    "route_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Route Id"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sensor_summary": {
      "$ref": "#/$defs/SensorSummary"
    },
    "started_at": {
      "title": "Started At",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "outcome",
    "started_at",
    "ended_at",
    "duration_s"
  ],
  "title": "RunSummary",
  "type": "object"
}
